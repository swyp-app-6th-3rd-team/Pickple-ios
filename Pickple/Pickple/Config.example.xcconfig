// 이 파일을 Config.xcconfig로 복사한 뒤 실제 키 값을 채워 넣으세요.
// Config.xcconfig는 .gitignore에 걸려있어 커밋되지 않습니다.
// Xcode에서 Project > Info > Configurations에서 Debug/Release 각각에
// Config.xcconfig를 Base Configuration File로 지정해야 실제로 적용됩니다.

KAKAO_NATIVE_APP_KEY = your_kakao_native_app_key
AMPLITUDE_API_KEY = your_amplitude_api_key
